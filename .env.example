# Copia este archivo como .env y completa los valores. El .env no se sube al repositorio.

# --- Claude (API de Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Profundidad de razonamiento: low (más rápido y barato) | medium | high. Vacío = el valor por defecto del modelo.
ANTHROPIC_EFFORT=medium
# Respaldo automático de modelo si el principal rechaza una solicitud por sus filtros de seguridad.
# "default" lo activa; déjalo vacío para apagarlo (por ejemplo, si usas un modelo que no lo soporta).
ANTHROPIC_FALLBACKS=default
# Herramientas con validación estricta de argumentos (desactívala si el modelo elegido no la soporta).
ANTHROPIC_STRICT_TOOLS=true
ANTHROPIC_MAX_TOKENS=16000

# --- Base de datos ---
# SQLite por defecto. Para migrar, cambia la URL e instala el driver (ver requirements.txt):
#   PostgreSQL: postgresql+psycopg://usuario:clave@localhost:5432/veterinaria
#   MySQL:      mysql+pymysql://usuario:clave@localhost:3306/veterinaria
DATABASE_URL=sqlite:///veterinaria.db

# --- Datos de la clínica ---
# Usa comillas si el valor tiene el carácter #, porque sin comillas se toma como comentario.
CLINICA_NOMBRE=Clínica Veterinaria Patitas
CLINICA_DIRECCION="Calle 45 # 12-30, Bogotá"
CLINICA_TELEFONO=601 555 1234
CLINICA_TELEFONO_URGENCIAS=300 555 9911
CLINICA_HORARIO=Lunes a viernes de 8:00 a. m. a 6:00 p. m.; sábados de 8:00 a. m. a 1:00 p. m.
CLINICA_ZONA_HORARIA=America/Bogota

# --- Reglas de agenda ---
AGENDA_INTERVALO_MINUTOS=30
AGENDA_ANTICIPACION_MINUTOS=60
AGENDA_DIAS_MAXIMOS=60

# --- Sesiones de chat ---
# Tras este tiempo sin mensajes se inicia una conversación nueva (útil en WhatsApp).
SESION_MINUTOS_INACTIVIDAD=720
# Dígitos de un número local; se usa para quitar el indicativo de país (57 3001112233 -> 3001112233).
TELEFONO_DIGITOS_LOCALES=10
